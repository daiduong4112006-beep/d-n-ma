rules_version = '2';

// =============================================================================
// DUN MASTER – Quy tắc bảo mật Firestore
// Mỗi người chỉ đọc / ghi dữ liệu của chính mình (khóa sở hữu = email đăng nhập
// Firebase Auth, viết thường). Bộ đề chia sẻ (shared_quizzes) ai cũng đọc được.
// Danh sách quyền JPD123 chỉ quản trị viên sửa được.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Phải đăng nhập VÀ đã xác minh email (Google luôn đã xác minh)
    function verifiedIdentity() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function signedIn() {
      return verifiedIdentity() && (request.auth.token.email.lower() == 'daiduong4112006@gmail.com'
        || !exists(/databases/$(database)/documents/admin_controls/$(request.auth.token.email.lower()))
        || get(/databases/$(database)/documents/admin_controls/$(request.auth.token.email.lower())).data.get('disabled', false) != true);
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && myEmail() == 'daiduong4112006@gmail.com';
    }
    // Tài liệu có trường email / userEmail trùng người đang đăng nhập
    function ownsExisting(field) {
      return signedIn() && field in resource.data && resource.data[field] == myEmail();
    }
    function ownsIncoming(field) {
      return signedIn() && request.resource.data[field] == myEmail();
    }

    // ---- Hồ sơ người dùng: users/{email} (không còn lưu mật khẩu) ----
    match /users/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow write: if signedIn() && myEmail() == email;
    }

    // Admin controls are separate from learner-editable profiles.
    match /admin_controls/{email} {
      allow read: if isAdmin() || (verifiedIdentity() && myEmail() == email);
      allow create, update: if isAdmin() && email != 'daiduong4112006@gmail.com'
        && request.resource.data.keys().hasOnly(['disabled', 'jpdModules', 'updatedAt'])
        && (!('disabled' in request.resource.data) || request.resource.data.disabled is bool)
        && (!('jpdModules' in request.resource.data) || (request.resource.data.jpdModules is list
          && request.resource.data.jpdModules.hasOnly(['vocabulary', 'kanji', 'grammar', 'speaking', 'exam-bank'])))
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
    match /admin_audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actor == myEmail()
        && request.resource.data.keys().hasOnly(['actor', 'target', 'at', 'before', 'after'])
        && request.resource.data.target is string && request.resource.data.at is string
        && request.resource.data.before is map && request.resource.data.after is map;
      allow update, delete: if false;
    }

    // ---- Cài đặt: settings/{email} và settings/jpd123_access_list ----
    match /settings/{docId} {
      allow read: if signedIn() && (docId == myEmail() || docId == 'jpd123_access_list');
      allow write: if signedIn() && (
        (docId == myEmail()) ||
        (docId == 'jpd123_access_list' && isAdmin())
      );
    }

    // ---- Bộ đề & lượt làm bài: khóa theo trường userEmail ----
    match /quizzes/{quizId} {
      allow read: if isAdmin() || ownsExisting('userEmail');
      allow delete: if ownsExisting('userEmail');
      allow create: if ownsIncoming('userEmail');
      allow update: if ownsExisting('userEmail') && ownsIncoming('userEmail');
    }
    match /attempts/{attemptId} {
      allow read: if isAdmin() || ownsExisting('userEmail');
      allow delete: if ownsExisting('userEmail');
      allow create: if ownsIncoming('userEmail');
      allow update: if ownsExisting('userEmail') && ownsIncoming('userEmail');
    }

    // ---- Dữ liệu học tập: khóa theo trường email ----
    match /user_japanese_courses/{docId} {
      allow read, delete: if ownsExisting('email');
      allow create: if ownsIncoming('email');
      allow update: if ownsExisting('email') && ownsIncoming('email');
    }
    match /srs_progress/{email} {
      allow read, write: if signedIn() && myEmail() == email;
    }
    match /fe_mock_exams/{email} {
      allow read, write: if signedIn() && myEmail() == email;
    }
    match /vocabulary/{email} {
      allow read, write: if signedIn() && myEmail() == email;
    }
    match /starred_questions/{docId} {
      allow read, delete: if ownsExisting('email');
      allow create, update: if ownsIncoming('email') && (resource == null || ownsExisting('email'));
    }
    match /flashcard_progress/{docId} {
      allow read, delete: if ownsExisting('email');
      allow create, update: if ownsIncoming('email') && (resource == null || ownsExisting('email'));
    }
    match /quiz_learning_progress/{docId} {
      allow read, delete: if ownsExisting('email');
      allow create, update: if ownsIncoming('email') && (resource == null || ownsExisting('email'));
    }
    match /practice_mistakes_progress/{docId} {
      allow read, delete: if ownsExisting('email');
      allow create, update: if ownsIncoming('email') && (resource == null || ownsExisting('email'));
    }
    match /study_progress/{docId} {
      allow read, delete: if ownsExisting('email');
      allow create, update: if ownsIncoming('email') && (resource == null || ownsExisting('email'));
    }

    // ---- Bộ đề chia sẻ: ai có link cũng đọc được, chỉ người tạo được sửa / xóa ----
    match /shared_quizzes/{shareId} {
      function notExpired() {
        return resource == null || !('expiresAtMs' in resource.data) || resource.data.expiresAtMs == null
          || request.time.toMillis() < resource.data.expiresAtMs;
      }
      function bumpOnly(field) {
        return request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1;
      }
      // Ai có link cũng xem được (trừ khi đã hết hạn); người tạo luôn xem được
      allow read: if notExpired() || ownsExisting('ownerEmail');
      allow create: if ownsIncoming('ownerEmail')
        && request.resource.data.quiz is map;
      allow update: if (ownsIncoming('ownerEmail') && (
          ownsExisting('ownerEmail') || !('ownerEmail' in resource.data)
        ))
        // Người xem chỉ được tăng lượt xem / lượt lưu thêm 1
        || (notExpired() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) && bumpOnly('views'))
        || (notExpired() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saves']) && bumpOnly('saves'));
      allow delete: if ownsExisting('ownerEmail');

      // Chế độ lớp học: mỗi người gửi điểm của mình, người chia sẻ xem được cả lớp
      match /results/{email} {
        function parent() {
          return get(/databases/$(database)/documents/shared_quizzes/$(shareId)).data;
        }
        allow read: if signedIn() && (myEmail() == email || parent().get('ownerEmail', '') == myEmail());
        allow create, update: if signedIn() && myEmail() == email
          && request.resource.data.email == myEmail()
          && parent().get('classMode', false) == true;
        allow delete: if signedIn() && parent().get('ownerEmail', '') == myEmail();
      }
    }

    // ---- Dữ liệu cũ dùng chung: chỉ quản trị viên ----
    match /japanese_courses/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Mọi thứ khác: chặn
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
